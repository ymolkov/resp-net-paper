name: Publish paper companion

on:
  workflow_dispatch:
    inputs:
      paper_url:
        description: Public bioRxiv article or DOI URL for this paper
        required: true
        type: string

permissions: {}

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  build:
    if: ${{ !github.event.repository.private }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Check out release
        uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: '3.12'
      - name: Set up Node
        uses: actions/setup-node@v7
        with:
          node-version: '22'
          package-manager-cache: false
      - name: Install site build tools
        run: |
          sudo apt-get update
          sudo apt-get install -y poppler-utils
          python -m pip install numpy==2.4.2 matplotlib==3.10.8
      - name: Build from frozen data
        run: python scripts/build_connectome_explorer.py
      - name: Verify atlas and companion
        run: make site-test companion-test PYTHON=python
      - name: Build paper page and explorer
        env:
          PAPER_URL: ${{ inputs.paper_url }}
        run: |
          python scripts/build_paper_companion.py "$RUNNER_TEMP/resp-net-paper" --paper-url "$PAPER_URL"
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: ${{ runner.temp }}/resp-net-paper
  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Configure Pages
        uses: actions/configure-pages@v5
      - name: Deploy companion and explorer
        id: deployment
        uses: actions/deploy-pages@v4
